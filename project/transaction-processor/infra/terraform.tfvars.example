aws_region     = "us-west-2"
aws_account_id = "123456789012"

# LabRole is the only principal the course environment permits for
# create/update/delete. Do NOT change lab_role_name.
lab_role_name = "LabRole"

# Set to true ONLY if your shell credentials are a user/role with
# sts:AssumeRole permission on LabRole. On AWS Academy the shell credentials
# ARE LabRole session credentials already, so leave this false.
provider_assume_lab_role = false

project_name = "transaction-processor"
environment  = "dev"

# Recommended: provide at least two subnets for ALB and ECS.
# subnet_ids = ["subnet-aaaaaaa", "subnet-bbbbbbb"]

app_image_tag    = "latest"
worker_image_tag = "latest"

api_desired_count    = 1
worker_desired_count = 1

locking_mode     = "optimistic"
lock_ttl_seconds = 90

# Set this above zero only when deliberately running the worker-crash experiment.
pre_commit_delay_ms = 0
