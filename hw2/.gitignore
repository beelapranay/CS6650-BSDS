# Local Terraform directories
**/.terraform/
.terraform/

# Terraform state files and backups
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# .tfvars files, which might contain sensitive data
*.tfvars
*.tfvars.json

# Override files, generally used for local testing
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore plan files
# *tfplan*